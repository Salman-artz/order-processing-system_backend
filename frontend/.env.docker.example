# ─────────────────────────────────────────────────────────────────────────────
# .env.docker.example — Environment variables for Docker deployment
#
# Usage:
#   cp .env.docker.example .env.docker
#   # Edit .env.docker as needed, then:
#   docker compose --env-file .env.docker up -d --build
#
# IMPORTANT — Next.js build-time embedding:
#   Variables prefixed with NEXT_PUBLIC_ are compiled into the JavaScript
#   bundle at BUILD TIME by `next build`. This means:
#     ✅ These values are correct for the environment where you ran `docker compose up --build`
#     ❌ Changing them in .env.docker AFTER the image is already built has NO effect
#        unless you rebuild with `--build` again.
#
#   If you need to deploy the same image to different environments (e.g., staging
#   vs production), you must rebuild the image for each environment, OR use a
#   runtime config endpoint pattern (advanced — out of scope for this project).
# ─────────────────────────────────────────────────────────────────────────────

# ── API Base URL ─────────────────────────────────────────────────────────────
# URL that the frontend uses to call the Order Service REST API.
#
# Default: host.docker.internal → points to your host machine from inside the
# Docker container. Works on Docker Desktop (Windows/Mac) automatically, and on
# Linux because docker-compose.yml sets extra_hosts: host.docker.internal:host-gateway.
NEXT_PUBLIC_API_BASE_URL=http://host.docker.internal:8080/api/v1

# ── WebSocket URL ─────────────────────────────────────────────────────────────
# URL for real-time order status updates (live Saga progress).
# Must use ws:// (or wss:// for HTTPS deployments).
NEXT_PUBLIC_WS_URL=ws://host.docker.internal:8080/ws

# ── Mock Mode ─────────────────────────────────────────────────────────────────
# Set to "true" to use built-in mock data instead of hitting the real backend.
# Useful for UI development or demo without a running backend.
# Default: false (use the real backend)
NEXT_PUBLIC_USE_MOCK=false

# ── Frontend Port ─────────────────────────────────────────────────────────────
# Host port that the container's port 3000 is mapped to.
# Change this if port 3000 is already occupied on your machine.
FRONTEND_PORT=3000

# ─────────────────────────────────────────────────────────────────────────────
# EXAMPLES FOR OTHER DEPLOYMENT SCENARIOS
# ─────────────────────────────────────────────────────────────────────────────

# ── Local dev machine, backend not in Docker (running natively):
# NEXT_PUBLIC_API_BASE_URL=http://host.docker.internal:8080/api/v1
# NEXT_PUBLIC_WS_URL=ws://host.docker.internal:8080/ws

# ── Backend deployed to a remote server / VM:
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api/v1
# NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com/ws

# ── Both frontend and backend on the same Docker network (same compose project):
# (If you ever merge both into one compose file)
# NEXT_PUBLIC_API_BASE_URL=http://order-service:8080/api/v1
# NEXT_PUBLIC_WS_URL=ws://order-service:8080/ws
