# ==============================================================
# WarehouseFlow — Distributed Warehouse & Order Fulfillment Platform
# Docker Environment Configuration (.env.docker)
# ==============================================================

# Server & Gateway Ports
ORDER_HTTP_PORT=8080
INVENTORY_HTTP_PORT=8081
INVENTORY_GRPC_PORT=50051
PAYMENT_HTTP_PORT=8082
NOTIFICATION_HTTP_PORT=8083

# Service Reverse-Proxy URLs (Internal Docker Network)
INVENTORY_HTTP_URL=http://inventory-service:8081
PAYMENT_HTTP_URL=http://payment-service:8082
INVENTORY_GRPC_URL=inventory-service:50051

# JWT Authentication
JWT_SECRET=warehouseflow_supersecret_jwt_key_change_in_production

# PostgreSQL Database Connections (Database-per-Service Pattern)
ORDER_DB_URL=postgres://postgres:123@postgres-order:5432/order_db?sslmode=disable
INVENTORY_DB_URL=postgres://postgres:123@postgres-inventory:5432/inventory_db?sslmode=disable
PAYMENT_DB_URL=postgres://postgres:123@postgres-payment:5432/payment_db?sslmode=disable
NOTIFICATION_DB_URL=postgres://postgres:123@postgres-notification:5432/notification_db?sslmode=disable

# NATS JetStream Event Broker
NATS_URL=nats://nats:4222

# Postgres Passwords (for init containers)
POSTGRES_PASSWORD=123

# Application Environment & Logging
APP_ENV=development
LOG_LEVEL=info
WAREHOUSE_DEFAULT_ZONE=ZONE-A
