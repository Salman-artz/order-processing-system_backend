# Server Ports
ORDER_HTTP_PORT=8080
INVENTORY_HTTP_PORT=8081
INVENTORY_GRPC_PORT=50051
PAYMENT_HTTP_PORT=8082
NOTIFICATION_HTTP_PORT=8083

# JWT
JWT_SECRET=supersecretjwtkey

# Database Connections (using Docker service names and the default password '123')
ORDER_DB_URL=postgres://postgres:123@postgres-order:5432/order_db?sslmode=disable
INVENTORY_DB_URL=postgres://postgres:123@postgres-inventory:5432/inventory_db?sslmode=disable
PAYMENT_DB_URL=postgres://postgres:123@postgres-payment:5432/payment_db?sslmode=disable
NOTIFICATION_DB_URL=postgres://postgres:123@postgres-notification:5432/notification_db?sslmode=disable

# NATS
NATS_URL=nats://nats:4222

# Postgres Passwords (for init)
POSTGRES_PASSWORD=123

# Logging
LOG_LEVEL=info
APP_ENV=development
