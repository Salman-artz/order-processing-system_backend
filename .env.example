# ==============================================================
# Order Processing System — Environment Configuration
#
# INSTRUKSI:
# 1. Copy file ini: cp .env.example .env
# 2. Ganti <user> dan <password> dengan kredensial PostgreSQL
#    lokal kamu (username & password yang biasa kamu pakai di
#    pgAdmin/TablePlus/psql)
# 3. Jangan commit file .env ke Git!
# ==============================================================

# ── PostgreSQL Connection Strings ─────────────────────────────
# <user>     = username PostgreSQL lokal kamu (contoh: postgres)
# <password> = password PostgreSQL lokal kamu

ORDER_DB_URL=postgres://<user>:<password>@localhost:5432/order_db?sslmode=disable
INVENTORY_DB_URL=postgres://<user>:<password>@localhost:5432/inventory_db?sslmode=disable
PAYMENT_DB_URL=postgres://<user>:<password>@localhost:5432/payment_db?sslmode=disable
NOTIFICATION_DB_URL=postgres://<user>:<password>@localhost:5432/notification_db?sslmode=disable

# ── NATS ──────────────────────────────────────────────────────
# NATS berjalan via Docker (docker compose up -d)
NATS_URL=nats://localhost:4222

# ── Auth ──────────────────────────────────────────────────────
# Ganti dengan random string yang kuat, minimal 32 karakter
# Contoh generate: openssl rand -hex 32
JWT_SECRET=<ganti-dengan-secret-key-yang-kuat-minimal-32-karakter>

# ── Port tiap Service (opsional, bisa di-override) ────────────
ORDER_SERVICE_PORT=8080
INVENTORY_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083

# ── gRPC Port ─────────────────────────────────────────────────
INVENTORY_GRPC_PORT=9091

# ── App Environment ───────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=debug
