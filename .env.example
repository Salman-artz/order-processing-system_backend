# ==============================================================
# WarehouseFlow — Distributed Warehouse & Order Fulfillment Platform
# Local Development Environment Configuration (.env)
# ==============================================================

# PostgreSQL Connection Strings (Local / Remapped Ports)
ORDER_DB_URL=postgres://postgres:123@localhost:7432/order_db?sslmode=disable
INVENTORY_DB_URL=postgres://postgres:123@localhost:7433/inventory_db?sslmode=disable
PAYMENT_DB_URL=postgres://postgres:123@localhost:7434/payment_db?sslmode=disable
NOTIFICATION_DB_URL=postgres://postgres:123@localhost:7435/notification_db?sslmode=disable

# NATS JetStream Event Bus
NATS_URL=nats://localhost:4222

# Service Gateway & Proxy URLs
INVENTORY_HTTP_URL=http://localhost:8081
PAYMENT_HTTP_URL=http://localhost:8082
INVENTORY_GRPC_URL=localhost:50051

# JWT Authentication
JWT_SECRET=warehouseflow_supersecret_jwt_key_change_in_production

# Microservice Local Ports
ORDER_SERVICE_PORT=8085
INVENTORY_SERVICE_PORT=8081
PAYMENT_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083

# App Environment & Observability
APP_ENV=development
LOG_LEVEL=info
WAREHOUSE_DEFAULT_ZONE=ZONE-A
